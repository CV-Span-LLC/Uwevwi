{
  "expo": {
    "name": "Uwevwi",
    "slug": "uwevwi",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "uwevwi",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "org.uwevwistudio.app",
      "supportsTablet": true
    },
    "android": {
      "package": "org.uwevwistudio.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
