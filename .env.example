# Backend (server/). Copy to .env or export in your shell.
PORT=8787
# Sites allowed to call the API from a browser, comma separated. Leave unset locally (any origin).
# CORS_ORIGIN=https://example.org
# URL of the website, used in password-reset links.
APP_URL=http://localhost:8092
# First admin account, created when the database is empty.
ADMIN_EMAIL=admin@uwevwistudio.org
ADMIN_NAME=Nazerin Gbinije
# If ADMIN_PASSWORD is not set, a random one is generated and printed once on first start.
ADMIN_PASSWORD=
# Optional: where the SQLite file lives (default server/data/uwevwi.db).
# DB_PATH=

# Frontend. Only needed when the API is not on the same host at port 8787.
# EXPO_PUBLIC_API_URL=https://api.example.com
