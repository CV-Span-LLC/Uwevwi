# For the Docker Compose setup only (see DEPLOY.md, option B). Copy to `.env` on the server and fill in.

# The site's domain, with no https:// and no trailing slash. Its DNS A record must point at this server.
DOMAIN=uwevwi.org

# Used once, to create the first admin account when the database is empty. Change it in the admin afterwards.
ADMIN_EMAIL=admin@uwevwi.org
ADMIN_NAME=Nazerin Gbinije
ADMIN_PASSWORD=

# Optional. Defaults to DOMAIN. Use ":80" to serve plain HTTP (no certificate) until the domain is ready.
# SITE_ADDRESS=:80
